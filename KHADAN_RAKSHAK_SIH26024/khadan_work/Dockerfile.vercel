FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Backend dependencies
COPY backend/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

# Backend
COPY backend/app ./backend/app

# Frontend
COPY frontend ./frontend

# ML runtime files
COPY ml/inference_pipeline.py ./ml/inference_pipeline.py
COPY ml/feature_engineering.py ./ml/feature_engineering.py
COPY ml/models ./ml/models

# Existing database, if present
COPY backend/khadan_rakshak.db ./backend/khadan_rakshak.db

# Upload directory
COPY backend/uploads ./backend/uploads

WORKDIR /app/backend

EXPOSE 80

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80}"]